DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sif_sentinel?schema=public"
REDIS_URL="redis://localhost:6379"

POSTGRES_DB=sif_sentinel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
NEXT_PUBLIC_API_URL=http://localhost:4000

# Security
JWT_SECRET="super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Next.js Web App Origin (for CORS)
WEB_ORIGIN="http://localhost:3000"

# AI / ML Service
ML_BASE_URL="http://127.0.0.1:8000"
ML_REQUEST_TIMEOUT_MS=10000
AI_WORKER_CONCURRENCY=2
AI_JOB_ATTEMPTS=3

# Cron
PATTERN_RECOMPUTE_CRON="0 2 * * *"
