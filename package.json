{
  "name": "sif-sentinel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:api && pnpm test:ai",
    "test:unit": "turbo run test --filter=web",
    "test:api": "turbo run test:e2e --filter=api",
    "test:e2e": "playwright test --config=apps/web/playwright.config.ts",
    "test:ai": "cd apps/ml && .venv\\Scripts\\python -m pytest",
    "test:a11y": "playwright test --config=apps/web/playwright.config.ts --grep a11y",
    "security:check": "pnpm audit",
    "clean": "turbo run clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "ml:evaluate": "cd apps/ml && .venv\\Scripts\\python training\\run_all.py",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "eslint": "^9.14.0",
    "globals": "^17.12.0",
    "husky": "^9.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.13",
    "turbo": "^2.2.0",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@9.0.0"
}
